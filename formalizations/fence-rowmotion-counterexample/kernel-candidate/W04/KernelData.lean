def KernelCertificate (k : Fin 237) : Prop :=
  row (orbit k) = orbit (next k) ∧
  orbitFingerprint (orbit k) = orbitCode k ∧
  (orbit k).card = orbitCard k ∧ orbitCodeInverse (orbitCode k) = k.val

